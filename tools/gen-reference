def preview_page(c):
    src = c["preview"]
    m = re.search(r"<head(?:\s[^>]*)?>", src, re.I)
    if not m:
        raise ValueError("component %s: preview.html has no <head>" % c["name"])
    return src[:m.end()] + "\n" + PREVIEW_HEAD + src[m.end():]


