def head_script(combos):
    """runs in <head>: sets the remembered (or asked for) combination before the first paint"""
    data = json.dumps(combos, separators=(",", ":"), sort_keys=True).replace("<", "\\u003c")
    themes = {}
    for c in combos:
        t = c["attributes"]["data-theme"]
        themes[t] = GEN.token_theme(t)
    tt = json.dumps(themes, separators=(",", ":"), sort_keys=True).replace("<", "\\u003c")
    return """<script>
window.INTERLEAF_COMBINATIONS = %s;
window.INTERLEAF_TOKEN_THEME = %s;
(function () {
  var C = window.INTERLEAF_COMBINATIONS, q = new URLSearchParams(location.search), s = {};
  try { s = JSON.parse(localStorage.getItem("interleaf-reference") || "{}") || {}; } catch (e) { s = {}; }
  function mq(m) { return window.matchMedia && matchMedia(m).matches; }
  var want = {
    voice: q.get("voice") || s.voice || C[0].voice,
    scheme: q.get("scheme") || s.scheme || (mq("(update: slow)") ? "eink" : mq("(prefers-color-scheme: dark)") ? "night" : C[0].scheme),
    pen: q.get("pen") || s.pen || String(C[0].pen)
  };
  var c = C.filter(function (x) { return x.voice === want.voice && x.scheme === want.scheme && String(x.pen) === String(want.pen); })[0] || C[0];
  window.INTERLEAF_CURRENT = c;
  var d = document.documentElement;
  Object.keys(c.attributes).forEach(function (k) { d.setAttribute(k, c.attributes[k]); });
  d.setAttribute("data-token-theme", window.INTERLEAF_TOKEN_THEME[c.attributes["data-theme"]] || "");
})();
</script>""" % (data, tt)


PAGE_SCRIPT = """<script>
(function () {
  var C = window.INTERLEAF_COMBINATIONS, d = document.documentElement;
  var form = document.getElementById("picker");
  var frames = Array.prototype.slice.call(document.querySelectorAll("iframe[data-preview]"));
  function current() { return window.INTERLEAF_CURRENT; }
  function send(f) {
    var c = current();
    if (f.contentWindow) f.contentWindow.postMessage({ interleaf: "theme", theme: c.attributes["data-theme"], pen: c.attributes["data-pen"] }, "*");
  }
  function apply(c) {
    window.INTERLEAF_CURRENT = c;
    Object.keys(c.attributes).forEach(function (k) { d.setAttribute(k, c.attributes[k]); });
    d.setAttribute("data-token-theme", window.INTERLEAF_TOKEN_THEME[c.attributes["data-theme"]] || "");
    try { localStorage.setItem("interleaf-reference", JSON.stringify({ voice: c.voice, scheme: c.scheme, pen: String(c.pen) })); } catch (e) { /* no storage: the choice lasts for this page */ }
    var cur = document.getElementById("picker-current");
