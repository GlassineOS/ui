#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""gen-apps: the voices for the programs that do not draw with glassine-ui, written into
a root file system tree (GlassineOS/shell's rootfs/), from the section "apps" of
voices/voices.json.

    gen-apps ROOTFS            write them
    gen-apps --check ROOTFS    exit 1 (and say which) when one is out of date

Written (GlassineOS/shell commits them; its `make check` runs --check):
    usr/share/themes/glassine-VOICE/gtk-3.0/gtk.css   GTK 3 apps (apps.gtk3, gtk3Note, gtk3Rules;
                                                      the shared base.css is the shell's own)
    usr/share/glassine/gtk4/VOICE.css                 GTK 4 / libadwaita apps (apps.gtk4 into
                                                      voices/gtk4.css.in)
    usr/bin/glassine-theme-apply                      the lines between its ">>> gen-apps" and
                                                      "<<< gen-apps" markers: apps.gtkFont
    usr/bin/glassine-wvkbd                            the same: apps.wvkbd, the on-screen keyboard

The paths are runtime names (gsettings gtk-theme glassine-VOICE, glassine-theme-apply's
copy of the GTK 4 file), so they stay where the shell installs them.
"""
import json
import os
import re
import sys
from string import Template

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "voices", "voices.json")
GTK4 = os.path.join(ROOT, "voices", "gtk4.css.in")
GTK3_COLOURS = ("bg", "fg", "sub", "view", "btn", "btn_fg", "btn_line", "line", "soft", "sel", "sel_fg",
                "head_bg", "head_fg")
WVKBD_BREAK = ("bg", "press", "text")            # a new line of options before these
OPT_KEY = re.compile(r"[A-Za-z][A-Za-z0-9-]*")   # a wvkbd option's name: it is spliced into the script
OPT_VALUE = re.compile(r"[A-Za-z0-9._ -]+")      # and its value: no quote, no shell character


def gtk3(name, a):
    note = a["gtk3Note"].replace("\n", "\n * ")
    out = ["/* %s */" % note,
           "/* Generated by GlassineOS/ui tools/gen-apps from voices/voices.json (apps.gtk3, gtk3Note,"
           " gtk3Rules): do not edit by hand. */"]
    out += ["@define-color glassine_%s %s;" % (k, a["gtk3"][k]) for k in GTK3_COLOURS]
    out += ['@import url("../../glassine-common/gtk-3.0/base.css");', ""]
    out += a["gtk3Rules"]
    return "\n".join(out) + "\n"


def gtk4(name, a):
    return Template(open(GTK4).read()).substitute(a["gtk4"], voice=name)


def sh_q(s):
    if not re.fullmatch(r"[A-Za-z0-9 ._-]*", s):
        raise ValueError("not a plain word: %r" % s)
    return '"%s"' % s


def theme_apply(voices, indent):
    return ["%s%s) font=%s ;;" % (indent, n, sh_q(voices[n]["apps"]["gtkFont"])) for n in voices]


def wvkbd(voices, indent):
    """The voices in voices.json's order (gen-voices has its own, and a test holds them equal);
    the first is the fallback, `*)`, and comes last."""
    out = []
    order = list(voices)
    for n in order[1:] + order[:1]:
        opts = voices[n]["apps"]["wvkbd"]
        lines, cur = [], []
        for k, v in opts.items():
            if k in WVKBD_BREAK and cur:
                lines.append(cur)
                cur = []
            if not OPT_KEY.fullmatch(k):
                raise ValueError("wvkbd %s: not an option name: %r" % (n, k))
            if not isinstance(v, str):
                raise ValueError("wvkbd %s: %s must be a string, not %r" % (n, k, v))
            if not OPT_VALUE.fullmatch(v):
                raise ValueError("wvkbd %s: %s: %r" % (n, k, v))
            v = sh_q(v) if " " in v else v
            cur.append(("-%s %s" if len(k) == 1 else "--%s %s") % (k, v))
        lines.append(cur)
        head = "%s%s) set -- " % (indent, "*" if n == order[0] else n)
        text = [head + " ".join(lines[0])]
        text += [indent + "    " + " ".join(ln) for ln in lines[1:]]
        out.append(" \\\n".join(text) + " ;;")
    return "\n".join(out).split("\n")


REGIONS = {"usr/bin/glassine-theme-apply": theme_apply, "usr/bin/glassine-wvkbd": wvkbd}
BEGIN, END = re.compile(r"^(\s*)# >>> gen-apps"), re.compile(r"^\s*# <<< gen-apps")


def region(path, old, fn, voices):
    lines = old.split("\n")
    b = [i for i, ln in enumerate(lines) if BEGIN.match(ln)]
    e = [i for i, ln in enumerate(lines) if END.match(ln)]
    if len(b) != 1 or len(e) != 1 or e[0] < b[0]:
        raise ValueError("%s: needs one '# >>> gen-apps' line and one '# <<< gen-apps' after it" % path)
    indent = BEGIN.match(lines[b[0]]).group(1)
    return "\n".join(lines[:b[0] + 1] + fn(voices, indent) + lines[e[0]:])


def outputs(rootfs, data):
    voices = data["voices"]
    for n in voices:
        yield "usr/share/themes/glassine-%s/gtk-3.0/gtk.css" % n, gtk3(n, voices[n]["apps"])
        yield "usr/share/glassine/gtk4/%s.css" % n, gtk4(n, voices[n]["apps"])
    for rel, fn in REGIONS.items():
        path = os.path.join(rootfs, rel)
        if not os.path.exists(path):
            raise ValueError("%s: missing (the script holds the markers)" % path)
        yield rel, region(rel, open(path).read(), fn, voices)


def main(argv):
    flags = [a for a in argv if a.startswith("--")]
    args = [a for a in argv if not a.startswith("--")]
    # a flag that is not --check must never fall through to a write: shell's make check runs this
    unknown = [f for f in flags if f != "--check"]
    if unknown or len(args) != 1:
        if unknown:
            print("gen-apps: unknown argument %s" % ", ".join(unknown), file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2
    check = bool(flags)
    rootfs = args[0]
    with open(DATA) as fh:
        data = json.load(fh)
    stale = []
    try:
        forms = list(outputs(rootfs, data))
    except (KeyError, ValueError) as e:
        print("gen-apps: %s" % (e.args[0] if e.args else e), file=sys.stderr)
        return 1
    for rel, text in forms:
        path = os.path.join(rootfs, rel)
        old = open(path).read() if os.path.exists(path) else None
        if old == text:
            continue
        if check:
            stale.append(rel)
        else:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as fh:
                fh.write(text)
            print("wrote", rel)
    if stale:
        print("gen-apps: out of date with GlassineOS/ui voices/voices.json (run %s %s): %s"
              % (os.path.abspath(__file__), rootfs, ", ".join(stale)), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
