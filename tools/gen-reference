# written into every site; a rebuild replaces a directory only if it holds this. Not .nojekyll:
# any Pages site has that one.
MARKER = ".gen-reference"


def build(dest, designs_stage=None):
    designs = read_designs(designs_stage) if designs_stage else None
    NAV[:] = list(PAGES) + ([DESIGNS_PAGE] if designs is not None else [])
    tok = GEN.Tokens(json.load(open(GEN.TOKENS, encoding="utf-8")))
    combos = json.load(open(os.path.join(WEB, "combinations.json"), encoding="utf-8"))["combinations"]
    comps = components()
    if os.path.isdir(dest):
        # replace only a directory this tool wrote: --out . or --out ~/site must not wipe anything
        if os.listdir(dest) and not os.path.isfile(os.path.join(dest, MARKER)):
            raise ValueError("%s is not empty and was not written by gen-reference (no %s in it); "
                             "give an empty or new directory, or remove it first" % (dest, MARKER))
        shutil.rmtree(dest)
    os.makedirs(os.path.join(dest, "previews"))
    # all of web/, so that whatever the web form loads beside it (fonts) comes along
    shutil.copytree(WEB, os.path.join(dest, "web"))
    files = {
        "reference.css": SITE_CSS,
        "index.html": guidelines_page(combos),
        "tokens.html": tokens_page(tok, combos),
        "components.html": components_page(comps, combos),
        ".nojekyll": "",
        MARKER: "",
    }
    for c in comps:
        files["previews/%s.html" % c["name"]] = preview_page(c)
    if designs is not None:
        shutil.copytree(designs_stage, os.path.join(dest, "designs"), symlinks=False)
        files["designs.html"] = designs_page(designs, combos)
        files["designs/index.html"] = ('<!doctype html>\n<meta charset="utf-8">\n<title>Design boards</title>\n'
                                       '<meta http-equiv="refresh" content="0; url=../designs.html">\n'
                                       '<a href="../designs.html">Design boards</a>\n')
        for pr in designs["prs"]:
            files["designs/pr-%d/index.html" % pr["number"]] = pr_index(pr)
    for rel, text in files.items():
        with open(os.path.join(dest, rel), "w", encoding="utf-8") as fh:
            fh.write(text)
    return dest


def main(argv):
    dest = os.path.join(ROOT, "out", "reference")
    designs = None
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--out" and args:
            dest = os.path.abspath(args.pop(0))
        elif a == "--designs" and args:
            designs = os.path.abspath(args.pop(0))
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            print("gen-reference: unknown argument %r (see --help)" % a, file=sys.stderr)
            return 2
    try:
        build(dest, designs)
    except (ValueError, KeyError, OSError) as e:
        print("gen-reference: %s" % e, file=sys.stderr)
        return 1
    print("gen-reference: wrote %s" % dest)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
