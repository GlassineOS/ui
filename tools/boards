#!/usr/bin/env node
// SPDX-License-Identifier: GPL-2.0-or-later
// tools/boards: design boards (spec 003).
//   boards preview DESIGN_DIR [--port N] [--host H] [--allow-host NAME]... [--interleaf DIR] [--web DIR]
//   boards check   DESIGN_DIR [--interleaf DIR] [--json FILE|-] [--board FILE]... [--jobs N]
//                  [--timeout MS] [--chromium PATH] [--allow-empty]
//   boards references DESIGN_DIR [--update] [--refs DIR] [--out DIR] [--json FILE|-] [--board FILE]...
//                  [--interleaf DIR] [--jobs N] [--timeout MS] [--chromium PATH] [--allow-empty]
//   boards shot    BOARD_FILE [--voice V] [--scheme S] [--pen P] [--size WxH] [--click SELECTOR]... [--out FILE]
//                  [--interleaf DIR] [--timeout MS] [--chromium PATH]
//   boards shots   [--out DIR] [--root DIR] [--jobs N] [--interleaf DIR] [--timeout MS] [--chromium PATH] < CHANGED_PATHS
//   boards stream  DESIGN_DIR [--interleaf DIR] [--web DIR] [--size WxH] [--chromium PATH]   (JSON lines on stdin/stdout)
//   boards import  CANVAS_EXPORT_DIR DEST_DIR [--force]
//   boards version
'use strict';
const fs = require('fs');
const path = require('path');
const LIB = path.join(__dirname, '..', 'boards', 'lib');

function usage(code) {
  process.stderr.write([
    'usage: boards preview DESIGN_DIR [--port N] [--host H] [--allow-host NAME]... [--interleaf DIR] [--web DIR]',
    '       boards check DESIGN_DIR [--interleaf DIR] [--json FILE|-] [--board FILE]... [--jobs N] [--timeout MS] [--chromium PATH] [--allow-empty]',
    '       boards references DESIGN_DIR [--update] [--refs DIR] [--out DIR] [--json FILE|-] [--board FILE]... [--interleaf DIR]',
    '                 [--jobs N] [--timeout MS] [--chromium PATH] [--allow-empty]',
    '       boards shot BOARD_FILE [--voice V] [--scheme S] [--pen P] [--size WxH] [--click SELECTOR]... [--out FILE]',
    '                 [--interleaf DIR] [--timeout MS] [--chromium PATH]',
    '       boards shots [--out DIR] [--root DIR] [--jobs N] [--interleaf DIR] [--timeout MS] [--chromium PATH] < CHANGED_PATHS',
    '       boards stream DESIGN_DIR [--interleaf DIR] [--web DIR] [--size WxH] [--chromium PATH]',
    '       boards import CANVAS_EXPORT_DIR DEST_DIR [--force]',
    '       boards version',
    '',
  ].join('\n'));
  process.exit(code);
}

function parse(argv, spec) {
  const pos = [], opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-h' || a === '--help') usage(0);
    if (a.startsWith('--')) {
      const [k, inline] = a.slice(2).split('=', 2);
      if (!(k in spec)) { process.stderr.write('boards: unknown option --' + k + '\n'); usage(2); }
      if (spec[k] === 'flag') { opt[k] = true; continue; }
      const v = inline !== undefined ? inline : argv[++i];
      if (v === undefined) { process.stderr.write('boards: --' + k + ' needs a value\n'); usage(2); }
      if (spec[k] === 'list') (opt[k] = opt[k] || []).push(v); else opt[k] = v;
    } else pos.push(a);
  }
  return { pos: pos, opt: opt };
}

// the JSON report to FILE (or stdout for "-") and the summary; exit 1 unless every case passed
function writeReport(rep, out, text) {
  const json = JSON.stringify(rep, null, 1) + '\n';
  if (out === '-') process.stdout.write(json);
  else { fs.mkdirSync(path.dirname(path.resolve(out)), { recursive: true }); fs.writeFileSync(out, json); }
  process[out === '-' ? 'stderr' : 'stdout'].write(text + '\n' + (out === '-' ? '' : '  report: ' + out + '\n'));
  return rep.summary.ok ? 0 : 1;
}

async function main() {
  const cmd = process.argv[2];
  const rest = process.argv.slice(3);
  if (cmd === 'version') {
    const T = require(path.join(__dirname, '..', 'boards', 'runtime', 'template.js'));
    process.stdout.write('boards subset ' + T.SUBSET_VERSION + '\n');
    return 0;
  }
  if (cmd === 'preview') {
    const { pos, opt } = parse(rest, { port: 'value', host: 'value', 'allow-host': 'list', interleaf: 'value', web: 'value' });
    if (pos.length !== 1) usage(2);
    const { startServer } = require(path.join(LIB, 'server.js'));
    const srv = await startServer({ design: pos[0], interleaf: opt.interleaf, web: opt.web, host: opt.host, allowHosts: opt['allow-host'], port: opt.port ? Number(opt.port) : 4790, live: true });
    process.stdout.write('boards preview: ' + srv.design + '\n  Interleaf: ' + srv.interleaf + '\n  ' + srv.url + '_boards/\n');
    for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, function () { srv.close().then(function () { process.exit(0); }); });
    await new Promise(function () {});
  }
  if (cmd === 'check') {
    const { pos, opt } = parse(rest, { interleaf: 'value', json: 'value', board: 'list', jobs: 'value', timeout: 'value', chromium: 'value', 'allow-empty': 'flag' });
    if (pos.length !== 1) usage(2);
    const { checkDesign, textSummary } = require(path.join(LIB, 'check.js'));
    const rep = await checkDesign({ design: pos[0], interleaf: opt.interleaf, boards: opt.board, jobs: opt.jobs ? Number(opt.jobs) : 4,
      timeout: opt.timeout ? Number(opt.timeout) : 30000, chromium: opt.chromium, allowEmpty: opt['allow-empty'] });
    const json = JSON.stringify(rep, null, 1) + '\n';
    const out = opt.json || path.join('out', 'boards-check.json');
    if (out === '-') process.stdout.write(json);
    else { fs.mkdirSync(path.dirname(path.resolve(out)), { recursive: true }); fs.writeFileSync(out, json); }
    process[out === '-' ? 'stderr' : 'stdout'].write(textSummary(rep) + '\n' + (out === '-' ? '' : '  report: ' + out + '\n'));
    return rep.summary.failing || rep.summary.missing ? 1 : 0;
  }
  if (cmd === 'references') {
    const { pos, opt } = parse(rest, { update: 'flag', refs: 'value', out: 'value', json: 'value', board: 'list', interleaf: 'value', jobs: 'value',
      timeout: 'value', chromium: 'value', 'allow-empty': 'flag' });
    if (pos.length !== 1) usage(2);
    const R = require(path.join(LIB, 'references.js'));
    const rep = await R.shootDesign({ design: pos[0], interleaf: opt.interleaf, refs: opt.refs, out: opt.out, update: opt.update, boards: opt.board,
      jobs: opt.jobs ? Number(opt.jobs) : 4, timeout: opt.timeout ? Number(opt.timeout) : 30000, chromium: opt.chromium, allowEmpty: opt['allow-empty'] });
    return writeReport(rep, opt.json || path.join(rep.out, 'report.json'), R.textSummary(rep, 'boards references (' + rep.design + ')'));
  }
  if (cmd === 'shot') {
    const { pos, opt } = parse(rest, { voice: 'value', scheme: 'value', pen: 'value', size: 'value', click: 'list', out: 'value', interleaf: 'value',
      timeout: 'value', chromium: 'value' });
    if (pos.length !== 1) usage(2);
    const S = require(path.join(LIB, 'shot.js'));
    const size = opt.size === undefined ? undefined : S.parseSize(opt.size);
    if (size === null) { process.stderr.write('boards: --size is WIDTHxHEIGHT, not "' + opt.size + '"\n'); usage(2); }
    const rep = await S.shootBoard({ board: pos[0], voice: opt.voice, scheme: opt.scheme, pen: opt.pen, size: size, clicks: opt.click, out: opt.out,
      interleaf: opt.interleaf, timeout: opt.timeout ? Number(opt.timeout) : 30000, chromium: opt.chromium });
    process.stdout.write(JSON.stringify(rep, null, 1) + '\n');
    return rep.ok ? 0 : 1;
  }
  if (cmd === 'stream') {
    const { pos, opt } = parse(rest, { interleaf: 'value', web: 'value', size: 'value', chromium: 'value' });
    if (pos.length !== 1) usage(2);
    const size = opt.size === undefined ? {} : require(path.join(LIB, 'shot.js')).parseSize(opt.size);
    if (size === null) { process.stderr.write('boards: --size is WIDTHxHEIGHT, not "' + opt.size + '"\n'); usage(2); }
    const { startStream } = require(path.join(LIB, 'stream.js'));
    const out = function (e) { process.stdout.write(JSON.stringify(e) + '\n'); };
    const st = await startStream({ design: pos[0], interleaf: opt.interleaf, web: opt.web, chromium: opt.chromium, width: size.width, height: size.height, onEvent: out });
    // one command per line; the end of stdin ends the stream
    let buf = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', function (d) {
      buf += d;
      let i;
      while ((i = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, i).trim();
        buf = buf.slice(i + 1);
        if (!line) continue;
        let c;
        try { c = JSON.parse(line); } catch (e) { out({ ev: 'error', message: 'not JSON: ' + line.slice(0, 80) }); continue; }
        st.send(c);
      }
    });
    await new Promise(function (res) { process.stdin.on('end', res); for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, res); });
    await st.close();
    return 0;
  }
  if (cmd === 'shots') {
    const { pos, opt } = parse(rest, { out: 'value', root: 'value', jobs: 'value', interleaf: 'value', timeout: 'value', chromium: 'value' });
    if (pos.length) usage(2);
    const S = require(path.join(LIB, 'shot.js'));
    const out = opt.out || path.join('out', 'shots');
    const root = path.resolve(opt.root || '.');
    const boards = S.changedBoards(fs.readFileSync(0, 'utf8').split('\n').filter(Boolean), root);
    const rep = await S.shootBoards({ boards: boards, root: root, out: out, jobs: opt.jobs ? Number(opt.jobs) : 4, interleaf: opt.interleaf,
      timeout: opt.timeout ? Number(opt.timeout) : 30000, chromium: opt.chromium });
    fs.mkdirSync(out, { recursive: true });
    fs.writeFileSync(path.join(out, 'report.json'), JSON.stringify(rep, null, 1) + '\n');
    process.stdout.write('boards shots: ' + rep.summary.boards + ' boards, ' + rep.summary.failing + ' failing, in ' + out + '\n');
    for (const r of rep.boards) if (!r.ok) process.stdout.write('  FAIL ' + r.board + ': ' + (r.errors[0] ? r.errors[0].message : 'no image') + '\n');
    return rep.summary.ok ? 0 : 1;
  }
  if (cmd === 'import') {
    const { pos, opt } = parse(rest, { force: 'flag' });
    if (pos.length !== 2) usage(2);
    const { importCanvas } = require(path.join(LIB, 'import.js'));
    const r = importCanvas(pos[0], pos[1], { force: opt.force });
    process.stdout.write('boards import: ' + r.copied.length + ' files into ' + path.resolve(pos[1]) + '\n');
    if (r.left.length) {
      process.stdout.write('  left out:\n');
      for (const l of r.left) process.stdout.write('    ' + l.path + '  (' + l.why + ')\n');
    }
    return 0;
  }
  usage(cmd ? 2 : 0);
}

main().then(function (code) { process.exitCode = code || 0; }, function (e) {
  process.stderr.write('boards: ' + (e && e.message || e) + '\n');
  process.exitCode = 2;
});
