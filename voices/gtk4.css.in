/* glassine: libadwaita in the glassine-shell "${voice}" theme — glassine-theme-apply copies this to
 * ~/.config/gtk-4.0/gtk.css (GTK4 apps read it when they start). Ink accents,
 * no shades, no transitions: e-ink.
 * Generated by GlassineOS/ui tools/gen-apps from voices/gtk4.css.in and voices/voices.json
 * (apps.gtk4): do not edit by hand. */
:root {
  --window-bg-color: ${paper}; --window-fg-color: ${ink};
  --view-bg-color: ${paper}; --view-fg-color: ${ink};
  --headerbar-bg-color: ${headBg}; --headerbar-fg-color: ${headFg}; --headerbar-border-color: ${headBorder};
  --headerbar-backdrop-color: ${headBg}; --headerbar-shade-color: transparent; --headerbar-darker-shade-color: transparent;
  --sidebar-bg-color: ${paper}; --sidebar-fg-color: ${ink}; --sidebar-backdrop-color: ${paper}; --sidebar-shade-color: transparent;
  --secondary-sidebar-bg-color: ${paper}; --secondary-sidebar-fg-color: ${ink};
  --card-bg-color: ${paper}; --card-fg-color: ${ink}; --card-shade-color: transparent;
  --dialog-bg-color: ${paper}; --dialog-fg-color: ${ink};
  --popover-bg-color: ${paper}; --popover-fg-color: ${ink}; --popover-shade-color: transparent;
  --thumbnail-bg-color: ${paper}; --thumbnail-fg-color: ${ink};
  --accent-bg-color: ${accent}; --accent-fg-color: ${onAccent}; --accent-color: ${accent};
  --destructive-bg-color: ${accent}; --destructive-fg-color: ${onAccent}; --destructive-color: ${accent};
  --success-bg-color: ${accent}; --success-fg-color: ${onAccent}; --success-color: ${accent};
  --warning-bg-color: ${accent}; --warning-fg-color: ${onAccent}; --warning-color: ${accent};
  --error-bg-color: ${accent}; --error-fg-color: ${onAccent}; --error-color: ${accent};
  --shade-color: transparent; --scrollbar-outline-color: transparent;
}
@define-color window_bg_color ${paper};
@define-color window_fg_color ${ink};
@define-color view_bg_color ${paper};
@define-color view_fg_color ${ink};
@define-color headerbar_bg_color ${headBg};
@define-color headerbar_fg_color ${headFg};
@define-color headerbar_border_color ${headBorder};
@define-color card_bg_color ${paper};
@define-color card_fg_color ${ink};
@define-color popover_bg_color ${paper};
@define-color popover_fg_color ${ink};
@define-color dialog_bg_color ${paper};
@define-color dialog_fg_color ${ink};
@define-color accent_bg_color ${accent};
@define-color accent_fg_color ${onAccent};
@define-color accent_color ${accent};
* { transition: none; animation: none; }
.card, row.card, list.boxed-list, popover > contents { box-shadow: 0 0 0 1px ${line}; }

/* Plain windows (with glassine-epdd-desktop compositing): no client-side shadow
 * margin, no rounded corners, no window border — square and opaque. */
window, window.csd, window.solid-csd, window.maximized, window.fullscreen, window.tiled,
dialog, window.dialog, messagedialog, window.messagedialog, tooltip, .tooltip,
headerbar, .titlebar, window.csd > .titlebar {
    border-radius: 0; box-shadow: none; outline: none; margin: 0;
}
window.csd, window.solid-csd { border: none; }
/* no compositor announced (glassine-epdd-desktop): GTK4 marks windows solid-csd and
 * libadwaita pads them 4 px for resize handles, drawn as a dark frame */
window.solid-csd { padding: 0; }
dialog.floating sheet, floating-sheet > sheet, .floating sheet { border-radius: 0; }

/* No soft shadows (e-ink renders blur as grey dither): libadwaita's knobs, toasts,
 * sheets and raised bars get a hairline instead; dimming, scroll edge and page
 * transition shadows go. Inset outlines (check, radio, entries) stay. */
* { text-shadow: none; -gtk-icon-shadow: none; }
/* Nautilus (and other GTK4 icon views) draw a per-icon drop-shadow filter: one
 * blurred offscreen pass per visible icon, every frame, ~half of a scroll frame
 * on a small GPU. User CSS outranks the app's own. */
.view picture { filter: none; }
switch > slider, scale > trough > slider, scale > trough > slider:hover { box-shadow: 0 0 0 1px ${line}; }
toast { box-shadow: none; background-color: ${line}; color: ${onAccent}; }
.osd, .app-notification { box-shadow: none; text-shadow: none; }
dialog.floating sheet, floating-sheet > sheet, dialog.bottom sheet, bottom-sheet > sheet { box-shadow: 0 0 0 1px ${line}; }
dimming, floating-sheet > dimming, bottom-sheet > dimming { background: none; }
navigation-view > shadow, overlay-split-view > shadow, flap > shadow, leaflet > shadow,
navigation-view > border, overlay-split-view > border, flap > border, leaflet > border,
flap > outline, leaflet > outline { background: none; box-shadow: none; }
undershoot.top, undershoot.bottom, undershoot.left, undershoot.right,
overshoot.top, overshoot.bottom, overshoot.left, overshoot.right { background: none; box-shadow: none; }
toolbarview > .top-bar.raised, toolbarview > .bottom-bar.raised,
.top-bar.raised, .bottom-bar.raised, searchbar > revealer > box { box-shadow: none; }
toolbarview > .top-bar.raised { box-shadow: 0 1px ${line}; }
toolbarview > .bottom-bar.raised { box-shadow: 0 -1px ${line}; }
