#!/usr/bin/env node
// SPDX-License-Identifier: GPL-2.0-or-later
// tools/contrast: the Interleaf contrast check (spec 002 FR-020, FR-023), headless.
//   contrast [--json FILE|-] [--component NAME]... [--theme ID|VOICE|SCHEME]... [--width desktop|phone]...
//            [--inject CSS]... [--open FILE] [--previews DIR] [--jobs N] [--chromium PATH] [--quiet]
// Every component preview (interleaf/components/*/preview.html) in every combination of
// web/combinations.json, at desktop (1280px) and phone (390px) width, in the states the guidelines
// name. --open FILE: known open failures, reported as "open" and not failed (an entry that no
// longer fails is stale and fails the check). --inject CSS: a stylesheet after the component
// styles (the known-failure fixtures use it).
// Exits 1 when a case fails (or a page could not be measured). Needs Chromium: tools/in-alpine.
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const C = require(path.join(__dirname, 'lib', 'contrast.js'));

function usage(code) {
  process.stderr.write('usage: contrast [--json FILE|-] [--component NAME]... [--theme ID]... [--width desktop|phone]...\n' +
    '                [--inject CSS]... [--open FILE] [--previews DIR] [--jobs N] [--chromium PATH] [--quiet]\n');
  process.exit(code);
}

const opt = { components: [], themes: [], widths: [], injects: [], jobs: Math.max(2, Math.min(8, os.cpus().length)) };
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i], v = function () { if (i + 1 >= argv.length) usage(2); return argv[++i]; };
  if (a === '--json') opt.json = v();
  else if (a === '--component') opt.components.push(v());
  else if (a === '--theme') opt.themes.push(v());
  else if (a === '--width') { const w = v(); if (!C.WIDTHS[w]) usage(2); opt.widths.push(w); }
  else if (a === '--inject') opt.injects.push(path.resolve(v()));
  else if (a === '--open') opt.open = JSON.parse(fs.readFileSync(v(), 'utf8')).open;
  else if (a === '--previews') opt.previews = path.resolve(v());
  else if (a === '--jobs') opt.jobs = Number(v());
  else if (a === '--chromium') opt.chromium = v();
  else if (a === '--quiet') opt.quiet = true;
  else if (a === '-h' || a === '--help') usage(0);
  else usage(2);
}
if (!opt.quiet) opt.log = function (s) { process.stderr.write(s + '\n'); };

C.check(opt).then(function (rep) {
  if (opt.json === '-') process.stdout.write(JSON.stringify(rep, null, 1) + '\n');
  else if (opt.json) { fs.mkdirSync(path.dirname(path.resolve(opt.json)), { recursive: true }); fs.writeFileSync(opt.json, JSON.stringify(rep, null, 1) + '\n'); }
  (opt.json === '-' ? process.stderr : process.stdout).write(C.summary(rep) + '\n');
  process.exit(rep.ok ? 0 : 1);
}, function (e) {
  process.stderr.write('contrast: ' + (e && e.stack || e) + '\n');
  process.exit(2);
});
