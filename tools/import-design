"""import-design SHELL.json SETUP.json: refresh voices/voices.json from the design.

The dumps come from the design canvas's component scripts (claude.ai design
"E-ink Shell"), evaluated with node:
    node tools/design/shell-dump.js EinkSettingsCard.js SHELL.json   # shell + card + scheme
    node tools/design/setup-dump.js EinkSetup.js SETUP.json          # setup + scheme
Every var(--il-NAME[,fallback]) is resolved against the voice's E-ink tokens. The
sections scheme, card and setup are replaced; in shell the design's keys are
replaced and the keys the design does not have (the C table's own) are kept; "c"
is kept. Then run tools/gen-voices. Only the E-ink scheme is used."""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "voices", "voices.json")
VAR = re.compile(r"var\(--il-([a-z-]+)(?:,((?:[^()]|\([^()]*\))*))?\)")


def resolve(v, il):
    if isinstance(v, str):
        for _ in range(4):
            n = VAR.sub(lambda m: il.get("--il-" + m.group(1)) or (m.group(2) or "").strip(), v)
            if n == v:
                break
            v = n
        return v
    if isinstance(v, list):
        return [resolve(x, il) for x in v]
    if isinstance(v, dict):
        return {k: resolve(x, il) for k, x in v.items()}
    return v


def scheme(il):
    return dict(sorted((k[5:], v) for k, v in il.items() if k.startswith("--il-")))


def main(shell_dump, setup_dump):
    data = json.load(open(DATA))
    sd, ud = json.load(open(shell_dump)), json.load(open(setup_dump))
    for name, v in data["voices"].items():
        il = sd[name]["il"]
        if scheme(il) != scheme(ud[name]["il"]):
            sys.exit("import-design: %s: the two dumps' E-ink tokens differ" % name)
        v["scheme"] = scheme(il)
        shell = {k: resolve(x, il) for k, x in sd[name]["t"].items() if k != "ilv"}
        v["shell"] = dict(sorted(dict(v["shell"], **shell).items()))
        v["card"] = dict(sorted((k, resolve(x, il)) for k, x in sd[name]["k"].items()))
        v["setup"] = dict(sorted((k, resolve(x, ud[name]["il"])) for k, x in ud[name]["k"].items()))
    with open(DATA, "w") as fh:
        fh.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    print("voices/voices.json updated: now run tools/gen-voices")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    main(*sys.argv[1:3])
