# ---- Markdown (the subset the guidelines use) -------------------------------------------

def slug(text):
    s = re.sub(r"<[^>]+>", "", text)
    s = html.unescape(s).lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s or "section"


def inline(text):
    """inline Markdown: `code`, **strong**, *em*, [text](url); everything else escaped"""
    out, pos = [], 0
    for m in re.finditer(r"`([^`]+)`", text):
        out.append(inline_plain(text[pos:m.start()]))
        out.append('<code class="il-code-inline">%s</code>' % esc(m.group(1), quote=False))
        pos = m.end()
    out.append(inline_plain(text[pos:]))
    return "".join(out)


def inline_plain(text):
    s = esc(text, quote=False)
    # s is already escaped but for quotes, which would end the attribute: escape those in the target
    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)",
               lambda m: '<a class="il-link" href="%s">%s</a>'
               % (m.group(2).replace('"', "&quot;").replace("'", "&#x27;"), m.group(1)), s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", s)
    return s


LIST_ITEM = re.compile(r"^( *)([-*]|\d+\.) +(.*)$")


def markdown(text, h2_class="il-h2", skip_h1=False):
    """(html, [(id, heading)] of the h2s)"""
    lines = text.splitlines()
    out, toc, para = [], [], []
    i = 0

    def flush():
        if para:
            out.append("<p>%s</p>" % inline(" ".join(l.strip() for l in para)))
            para.clear()

    while i < len(lines):
        line = lines[i]
        if not line.strip():
            flush()
            i += 1
            continue
        m = re.match(r"^(#{1,6}) +(.*?) *#*$", line)
        if m:
            flush()
            level, title = len(m.group(1)), m.group(2)
            i += 1
            if level == 1 and skip_h1:
                continue
            hid = slug(title)
            cls = ' class="%s"' % h2_class if level == 2 and h2_class else ""
            if level == 2:
                toc.append((hid, title))
            out.append('<h%d id="%s"%s>%s</h%d>' % (level, hid, cls, inline(title), level))
            continue
        if line.lstrip().startswith("|"):
            flush()
            rows = []
            while i < len(lines) and lines[i].lstrip().startswith("|"):
                rows.append(lines[i].strip())
                i += 1
            out.append(md_table(rows))
            continue
        if LIST_ITEM.match(line):
            flush()
            block = []
            while i < len(lines) and lines[i].strip() and (LIST_ITEM.match(lines[i]) or lines[i].startswith(" ")):
                block.append(lines[i])
                i += 1
            out.append(md_list(block))
            continue
        para.append(line)
        i += 1
    flush()
    return "\n".join(out), toc


def cells(row):
    row = row.strip()
    if row.startswith("|"):
        row = row[1:]
    if row.endswith("|"):
        row = row[:-1]
    return [c.strip() for c in row.split("|")]


def md_table(rows):
    head = cells(rows[0])
    body = [cells(r) for r in rows[1:] if not re.fullmatch(r"\|?[\s:|-]+\|?", r)]
    h = "".join('<th scope="col">%s</th>' % inline(c) for c in head)
    b = "".join("<tr>%s</tr>" % "".join("<td>%s</td>" % inline(c) for c in r) for r in body)
    return '<div class="il-table-wrap"><table class="il-table"><thead><tr>%s</tr></thead><tbody>%s</tbody></table></div>' % (h, b)


def md_list(block):
    """nested lists by indentation; a continuation line joins its item"""
    items = []  # (indent, ordered, text)
    for line in block:
        m = LIST_ITEM.match(line)
        if m:
            items.append([len(m.group(1)), m.group(2)[0].isdigit(), m.group(3)])
        elif items:
            items[-1][2] += " " + line.strip()

    def build(start, indent):
        tag = "ol" if items[start][1] else "ul"
        parts, k = [], start
        while k < len(items) and items[k][0] >= indent:
            if items[k][0] > indent:
                sub, k = build(k, items[k][0])
                parts[-1] = parts[-1][:-5] + sub + "</li>"
                continue
            parts.append("<li>%s</li>" % inline(items[k][2]))
            k += 1
        return "<%s>%s</%s>" % (tag, "".join(parts), tag), k

    out, k = [], 0
    while k < len(items):
        s, k = build(k, items[k][0])
        out.append(s)
    return "".join(out)


# ---- the components ---------------------------------------------------------------------

DSCARD = re.compile(r"^\s*<!--\s*@dsCard\b(.*?)-->\s*\n?", re.S)
DSCARD_ATTR = re.compile(r'(\w+)=(?:"([^"]*)"|(\S+))')


def components():
    out = []
    for name in sorted(os.listdir(COMPONENTS)):
        d = os.path.join(COMPONENTS, name)
        if not os.path.isdir(d):
            continue
        prev = os.path.join(d, "preview.html")
        if not os.path.isfile(prev):
            raise ValueError("component %s: no preview.html" % name)
        src = open(prev, encoding="utf-8").read()
        m = DSCARD.match(src)
        card = {}
        if m:
            for a in DSCARD_ATTR.finditer(m.group(1)):
                card[a.group(1)] = a.group(2) if a.group(2) is not None else a.group(3)
            src = src[m.end():]
        readme = os.path.join(d, "README.md")
        title = re.sub(r"(?<=[a-z])(?=[A-Z])", " ", name)
        text = None
        if os.path.isfile(readme):
            text = open(readme, encoding="utf-8").read()
            h = re.search(r"^# +(.+)$", text, re.M)
            if h:
                title = h.group(1).strip()
        out.append({"name": name, "title": title, "group": card.get("group") or "Other",
                    "height": int(card.get("height") or 240), "subtitle": card.get("subtitle"),
                    "preview": src, "readme": text})
    return out


