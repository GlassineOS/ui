#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# tools/chromium-bump [BODY]: move tools/chromium.pin to the newest Chromium that Alpine offers in
# the release tools/in-alpine uses, before Alpine drops the pinned one (README "References").
# Writes the new pin (and the README's mention of it), renders every reference with it
# (tools/in-alpine make references-update), runs the boards checks against the new references, and
# writes a Markdown summary for a pull request to BODY (default out/chromium-bump.md).
# Needs docker and jq; the .github/workflows/chromium-bump.yml job runs it every week.
#   exit 0   the pin moved; every reference renders pixel-identical (only the recorded versions change)
#   exit 3   the pin moved; references changed: BODY lists the cases, the renders and the images of
#            the differences are in out/chromium-bump/references/
#   exit 4   the pin is the newest; nothing changed
#   other    failure (no Chromium found, a render failed, a check failed)
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
BODY=${1:-out/chromium-bump.md}
ALPINE=$(grep -m 1 -o 'FROM alpine:[0-9.]*' tools/in-alpine | cut -d: -f2)
OLD=$(cat tools/chromium.pin)
NEW=$(docker run --rm "alpine:$ALPINE" sh -c 'apk update -q >/dev/null && apk list chromium' |
	sed -n 's/^chromium-\([0-9][^ ]*\) .*/\1/p' | head -n 1)
if [ -z "$NEW" ]; then
	echo "chromium-bump: Alpine $ALPINE offers no chromium package" >&2
	exit 1
fi
if [ "$NEW" = "$OLD" ]; then
	echo "chromium-bump: chromium $OLD is the newest in Alpine $ALPINE"
	exit 4
fi
echo "chromium-bump: chromium $OLD -> $NEW (Alpine $ALPINE)"
echo "$NEW" > tools/chromium.pin
old_re=$(printf '%s' "$OLD" | sed 's/[.[\*^$/]/\\&/g')
sed -i "s/chromium=$old_re/chromium=$NEW/g" README.md

# every reference rendered with the new pin; a failed render or a refused update stops here. The
# update's reports and images of differences are kept apart: the checks below write out/references/
rm -rf out/references out/chromium-bump/references
tools/in-alpine make references-update
mkdir -p out/chromium-bump
mv out/references out/chromium-bump/references
# the evidence: the boards checks of CI against the new references
tools/in-alpine make -k check-boards boards-check references

# which cases rendered differently: an update reports them as "updated" (identical ones "pass")
mkdir -p "$(dirname "$BODY")"
reports=$(ls out/chromium-bump/references/*/report.json)
changed=$(jq -s '[.[] | .cases[] | select(.status == "updated")] | length' $reports)
# the images are named by a hash of their pixels: any added or removed one is a changed render
pngs=$(git status --porcelain -- '*.png' | wc -l)
libs=$(jq -rs '[.[] | .libraries.differ[] | "\(.name) \(.references // "none") → \(.running // "none")"] | unique | .[]' $reports)

{
	echo "Moves the pinned Chromium from \`$OLD\` to \`$NEW\`, the newest \`chromium\` in Alpine $ALPINE, before Alpine drops the pinned package (README \"References\")."
	echo
	echo "Generated by the \`chromium-bump\` workflow (\`tools/chromium-bump\`): \`tools/chromium.pin\` and README moved, every reference rendered again with the new Chromium (\`tools/in-alpine make references-update\`), then \`make check-boards boards-check references\` passed against them."
	echo
	if [ "$changed" -eq 0 ] && [ "$pngs" -eq 0 ]; then
		echo "**All references render pixel-identical.** No image changed; only the recorded versions in the references' \`index.json\` files."
	else
		echo "**References changed: review before merging.** $changed case(s) render differently with Chromium $NEW; the new references are in this pull request ($pngs image file(s) added or removed). The renders and the images of the differences (the reference faded, differing pixels red) are in the \`references\` artifact of the workflow run."
		for r in $reports; do
			n=$(jq '[.cases[] | select(.status == "updated")] | length' "$r")
			[ "$n" -gt 0 ] || continue
			echo
			echo "<details open><summary>$(jq -r '.kind' "$r"): $n changed (of $(jq '.summary.cases' "$r"))</summary>"
			echo
			jq -r '[.cases[] | select(.status == "updated")] | .[:300][] |
				"- `\(.case)`: " + (if .reference == null then "new" else "\(.differing) pixels differ, largest channel difference \(.maxDelta)" end)' "$r"
			[ "$n" -le 300 ] || echo "- … and $((n - 300)) more (the report in the artifact lists all)"
			echo
			echo "</details>"
		done
	fi
	if [ -n "$libs" ]; then
		echo
		echo "The text packages (recorded, not pinned) also differ from those of the old references, so a difference may come from them rather than from Chromium:"
		echo
		printf '%s\n' "$libs" | sed 's/^/- /'
	fi
} > "$BODY"
cat "$BODY"
if [ "$changed" -eq 0 ] && [ "$pngs" -eq 0 ]; then exit 0; fi
exit 3
