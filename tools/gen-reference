def title_block(label, title, lead):
    return ('<div class="il-title-block"><span class="il-label">%s</span><h1 class="il-h1">%s</h1>%s</div>'
            % (esc(label), esc(title), '<p class="il-lead">%s</p>' % lead if lead else ""))


# ---- the pages --------------------------------------------------------------------------

def guidelines_page(combos):
    text = open(os.path.join(INTERLEAF, "README.md"), encoding="utf-8").read()
    paras = text.split("\n\n")
    lead = inline(paras[0].strip()) if paras and not paras[0].startswith("#") else ""
    rest = "\n\n".join(paras[1:]) if lead else text
    body, toc = markdown(rest)
    return frame("index.html", "Interleaf", title_block("Guidelines", "Interleaf", lead) + "\n" + body, toc, combos,
                 "The guidelines of Interleaf, the design system of GlassineOS.")


def colour_cell(tok, name, theme):
    raw = tok.raw(name, theme)
    val = tok.resolve(name, theme)
    alias = GEN.ALIAS.match(raw.strip()) if raw else None
    note = ('= %s<br>%s' % (esc(alias.group(1)), esc(val))) if alias else esc(val)
    return '<span class="ref-chip" style="background:%s"></span><span class="ref-value">%s</span>' % (esc(val), note)


def tokens_page(tok, combos):
    d, themes = tok.data, tok.themes
    tnames = {t["id"]: t["name"] for t in d["color"]["themes"]}
    out, toc = [title_block("Tokens", "Tokens",
                            "Every token of <code class=\"il-code-inline\">interleaf/tokens.json</code>, with its usage and its value "
                            "in each theme. The column of the theme you picked is shaded; the values are pen 1's, the other pens are "
                            "<code class=\"il-code-inline\">accent-2</code>, <code class=\"il-code-inline\">accent-3</code> and their highlights.")], []

    def section(sid, title, inner):
        toc.append((sid, title))
        out.append('<section class="ref-section" aria-labelledby="%s"><h2 class="il-h2" id="%s">%s</h2>%s</section>' % (sid, sid, esc(title), inner))

    head = "".join('<th scope="col" data-tt="%s">%s<span class="ref-value">%s</span></th>' % (t, esc(tnames[t]), esc(t)) for t in themes)
    rows = []
    for t in d["color"]["tokens"]:
        n = t["name"]
        if isinstance(t["value"], str):
            cellv = '<td colspan="%d">%s<span class="ref-value">every theme</span></td>' % (len(themes), colour_cell(tok, n, themes[0]))
        else:
            cellv = "".join('<td data-tt="%s">%s</td>' % (th, colour_cell(tok, n, th)) for th in themes)
        rows.append('<tr id="token-%s"><th scope="row"><span class="ref-name">%s</span><p class="ref-usage">%s</p></th>%s</tr>'
                    % (n, esc(n), inline(t.get("usage", "")), cellv))
    section("colour", "Colour",
            "<p>A value <code class=\"il-code-inline\">= name</code> is an alias of another token in the same theme.</p>"
            '<div class="il-table-wrap"><table class="il-table ref-colours"><thead><tr><th scope="col">Token</th>%s</tr></thead><tbody>%s</tbody></table></div>'
            % (head, "".join(rows)))

    rows = []
    for t in d["shadow"]["tokens"]:
        n = t["name"]
        cellv = []
        for th in themes:
            v = tok.resolve(n, th)
            if v is None:
                cellv.append('<td data-tt="%s"><span class="ref-none">—</span></td>' % th)
            else:
                cellv.append('<td data-tt="%s"><div class="ref-shadow-cell" data-theme="%s"><div class="ref-shadow-sample" style="box-shadow:%s"></div>'
                             '<span class="ref-value">%s</span></div></td>' % (th, th, esc(v), esc(v)))
        rows.append('<tr id="token-%s"><th scope="row"><span class="ref-name">%s</span><p class="ref-usage">%s</p></th>%s</tr>'
                    % (n, esc(n), inline(t.get("usage", "")), "".join(cellv)))
    section("shadow", "Shadow",
            "<p>Each sample sits on its theme's own paper. A dash: the theme's component styles don't read the token.</p>"
            '<div class="il-table-wrap"><table class="il-table ref-shadows"><thead><tr><th scope="col">Token</th>%s</tr></thead><tbody>%s</tbody></table></div>'
            % (head, "".join(rows)))

    typ = d["type"]
    parts = ["<h3>Families</h3>"]
    for fam, stack in typ["families"].items():
        parts.append('<div class="ref-type" id="family-%s"><span class="ref-name">--font-%s</span>'
                     '<p class="ref-type-sample" style="font-family:var(--font-%s);font-size:24px">Glassine between the pages, 0123456789</p>'
                     '<span class="ref-value">%s</span></div>' % (esc(fam), esc(fam), esc(fam), esc(stack)))
    if typ.get("fonts"):
        parts.append("<h3>Fonts</h3><ul>%s</ul>" % "".join(
            "<li><span class=\"ref-value\">%s</span></li>" % esc(json.dumps(f, ensure_ascii=False, sort_keys=True)) for f in typ["fonts"]))
    for g in typ["groups"]:
        parts.append("<h3>%s</h3>" % esc(g["name"]))
        for s in g["styles"]:
            fam = s.get("family", g.get("family"))
            props = ["family " + fam, s["fontSize"], "line height %s" % s["lineHeight"], "weight %s" % s["fontWeight"]]
            if s.get("letterSpacing"):
                props.append("tracking " + s["letterSpacing"])
            if s.get("fontStyle"):
                props.append(s["fontStyle"])
            parts.append('<div class="ref-type" id="type-%s"><span class="ref-name">.%s%s</span><p class="ref-type-sample %s%s">%s</p>'
                         '<span class="ref-value">%s</span><p class="ref-usage">%s</p></div>'
                         % (esc(s["name"]), GEN.TYPE_CLASS, esc(s["name"]), GEN.TYPE_CLASS, esc(s["name"]), esc(s.get("sample", s["name"])),
                            esc(" · ".join(props)), inline(s.get("usage", ""))))
    section("type", "Type", "".join(parts))

    samples = {
        "spacing": lambda v: '<div class="ref-bar" style="width:%s"></div>' % esc(v),
        "radius": lambda v: '<div class="ref-radius" style="border-radius:%s"></div>' % esc(v),
        "layout": lambda v: '<div class="ref-bar" style="width:%s"></div>' % esc(v),
        "stroke": lambda v: '<div class="ref-stroke" style="border-top:%s var(--ink)"></div>' % esc(v),
    }
    titles = {"spacing": "Space", "radius": "Radius", "layout": "Layout", "stroke": "Stroke"}
    for fam in PLAIN_FAMILIES:
        rows = []
        for t in d[fam]["tokens"]:
            rows.append('<tr id="token-%s"><th scope="row"><span class="ref-name">%s</span><p class="ref-usage">%s</p></th>'
                        '<td><span class="ref-value">%s</span></td><td style="width:50%%">%s</td></tr>'
                        % (t["name"], esc(t["name"]), inline(t.get("usage", "")), esc(t["value"]), samples[fam](t["value"])))
        section(fam, titles[fam], '<div class="il-table-wrap"><table class="il-table"><thead><tr><th scope="col">Token</th>'
                '<th scope="col">Value</th><th scope="col">Sample</th></tr></thead><tbody>%s</tbody></table></div>' % "".join(rows))
    return frame("tokens.html", "Interleaf tokens", "\n".join(out), toc, combos,
                 "Every Interleaf token with its usage and its value in each theme.")


def components_page(comps, combos):
    groups = []
    for c in comps:
        if c["group"] not in groups:
            groups.append(c["group"])
    out = [title_block("Components", "Components",
                       "Each component's guidelines and a live preview. The previews follow the voice, scheme and pen you pick.")]
    toc = []
    for g in groups:
        gid = "group-" + slug(g)
        out.append('<h2 class="il-h2" id="%s">%s</h2>' % (gid, esc(g)))
        for c in comps:
            if c["group"] != g:
                continue
            toc.append((c["name"], c["title"]))
            readme = markdown(c["readme"], h2_class=None, skip_h1=True)[0] if c["readme"] else \
                '<p class="ref-none">No guidelines yet.</p>'
            href = "previews/%s.html" % c["name"]
            out.append('<section class="ref-component" id="%s" aria-labelledby="%s-title">'
                       '<h3 id="%s-title">%s</h3>%s%s'
                       '<div class="ref-frame-wrap"><iframe class="ref-frame" data-preview src="%s" title="%s preview" '
                       'data-height="%d" style="height:%dpx" loading="lazy"></iframe></div>'
                       '<a class="il-link ref-open" href="%s">Open the %s preview on its own</a></section>'
                       % (c["name"], c["name"], c["name"], esc(c["title"]),
                          '<p class="il-lead">%s</p>' % esc(c["subtitle"]) if c["subtitle"] else "", readme,
                          href, esc(c["title"]), c["height"], c["height"], href, esc(c["title"])))
    return frame("components.html", "Interleaf components", "\n".join(out), toc, combos,
                 "Every Interleaf component with its guidelines and a live preview.")


# ---- the design boards ------------------------------------------------------------------

PROJECT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
PR_DIR = re.compile(r"^pr-([1-9][0-9]*)$")


def design_projects(folder):
    """[{name, title, boards, pages}] of the exported design folders in folder (tools/boards export)"""
    out = []
    for name in sorted(os.listdir(folder)):
        d = os.path.join(folder, name)
        if name == "pr.json" or PR_DIR.match(name) or not os.path.isdir(d):
            continue
        if not PROJECT_NAME.match(name) or name.startswith("pr-"):
            raise ValueError("%s: not a design folder name (letters, digits, . _ -; not pr-*)" % d)
        api = os.path.join(d, "_boards", "api", "canvas.json")
        if not os.path.isfile(api):
            raise ValueError("%s: not an export of a design (no _boards/api/canvas.json)" % d)
        c = json.load(open(api, encoding="utf-8"))
        out.append({"name": name, "title": str(c.get("title") or name),
                    "boards": sum(1 for b in c.get("boards", []) if b.get("exists")), "pages": len(c.get("pages") or [])})
    return out


def read_designs(stage):
    """{main: [project], prs: [{number, title, url, head, projects}]} from a stage (tools/site-designs)"""
    prs = []
    for name in sorted(os.listdir(stage)):
        m = PR_DIR.match(name)
        if not m:
            continue
        meta = json.load(open(os.path.join(stage, name, "pr.json"), encoding="utf-8"))
        if meta.get("number") != int(m.group(1)):
            raise ValueError("%s/pr.json: number %r is not %s" % (name, meta.get("number"), m.group(1)))
        url = str(meta.get("url") or "")
        if not url.startswith("https://"):
            raise ValueError("%s/pr.json: url must be https" % name)
        prs.append({"number": meta["number"], "title": str(meta.get("title") or ""), "url": url,
                    "head": re.sub(r"[^0-9a-f]", "", str(meta.get("head") or ""))[:40],
                    "projects": design_projects(os.path.join(stage, name))})
    prs.sort(key=lambda p: p["number"])
    return {"main": design_projects(stage), "prs": prs}


def project_items(projects, at):
    if not projects:
        return '<p class="ref-none">None.</p>'
    return "<ul>%s</ul>" % "".join(
        '<li><a class="il-link" href="%s%s/_boards/">%s</a> <span class="ref-value">%s/ · %d boards</span></li>'
        % (at, esc(p["name"]), esc(p["title"]), esc(p["name"]), p["boards"]) for p in projects)


def designs_page(designs, combos):
    out = [title_block("Designs", "Design boards",
                       "The boards of each design folder of the <code class=\"il-code-inline\">ui</code> repository, rendered in "
                       "your browser: the canvas, and each board with its voice, scheme and pen picker. A board is a proposal; "
                       "it can differ from the program it describes.")]
    toc = [("on-main", "On main"), ("pulls", "Open pull requests")]
    out.append('<section class="ref-section" aria-labelledby="on-main"><h2 class="il-h2" id="on-main">On main</h2>%s</section>'
               % project_items(designs["main"], "designs/"))
    items = []
    for pr in designs["prs"]:
        at = "designs/pr-%d/" % pr["number"]
        items.append('<section class="ref-component" id="pr-%d" aria-labelledby="pr-%d-title"><h3 id="pr-%d-title">'
                     '<a class="il-link" href="%s">#%d</a> %s</h3><p>Boards of <code class="il-code-inline">%s</code> '
                     '(<a class="il-link" href="%s">the pull request</a>):</p>%s</section>'
                     % (pr["number"], pr["number"], pr["number"], at, pr["number"], esc(pr["title"]), esc(pr["head"][:12]),
                        esc(pr["url"]), project_items(pr["projects"], at)))
    out.append('<section class="ref-section" aria-labelledby="pulls"><h2 class="il-h2" id="pulls">Open pull requests</h2>'
               '<p>Each open pull request of this repository that changes a design has its boards at '
               '<code class="il-code-inline">designs/pr-NUMBER/</code>, as of its latest commit, until it is closed.</p>%s</section>'
               % ("".join(items) or '<p class="ref-none">No open pull request changes a design.</p>'))
    return frame("designs.html", "Design boards", "\n".join(out), toc, combos,
                 "The design boards of GlassineOS, on main and in open pull requests.")


